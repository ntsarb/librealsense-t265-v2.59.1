diff --git a/packaging/README-upgrade.md b/packaging/README-upgrade.md
new file mode 100644
index 000000000..8cc365285
--- /dev/null
+++ b/packaging/README-upgrade.md
@@ -0,0 +1,55 @@
+# Upgrading to the T265-enabled librealsense2
+
+This tarball upgrades an existing librealsense **2.59.x** install (for
+example a standard manual build under `/usr/local`) to the T265-enabled
+fork (version 2.59.1+tm2.1), without reinstalling tools or headers.
+
+## Contents
+
+- `t265-upgrade.sh` — the upgrade script (detect, validate, backup, swap,
+  verify, rollback)
+- `librealsense2.so.2.59.1` — the T265 fork's core library (T265 firmware
+  embedded)
+- `librealsense2.so.2.59.1.sha256` — its SHA256
+- `README-upgrade.md` — this file
+
+## What it does
+
+The upgrade replaces only the core library `librealsense2.so.2.59.1`. The
+fork's library is a strict ABI superset of the standard one: same soname
+(`librealsense2.so.2.59`), byte-identical public headers, all standard
+device drivers present, plus T265 support and the embedded T265 firmware.
+Your existing tools (`rs-*`, `realsense-viewer`), headers, GL library, CMake
+config and udev rules are untouched and gain T265 support automatically.
+
+## Usage
+
+```bash
+tar xzf librealsense2-t265-upgrade_2.59.1+tm2.1_amd64.tar.gz
+sudo ./t265-upgrade.sh --dry-run     # check everything, change nothing
+sudo ./t265-upgrade.sh               # perform the upgrade (prompts)
+sudo ./t265-upgrade.sh --rollback    # restore the original library
+```
+
+The original library is backed up to
+`/var/lib/librealsense-t265/backup/<timestamp>/` before it is replaced;
+`--rollback` uses the state file `/var/lib/librealsense-t265/state`.
+
+## Notes
+
+- USB 3 is required for reliable T265 video streaming (enumeration and
+  pose work on USB 2).
+- If several copies of the librealsense core library exist (for example
+  under both `/usr/local/lib` and `/usr/lib`), the script warns and
+  upgrades the one the loader resolves first; use `--install-dir DIR` to
+  force a directory.
+- The script is idempotent: if the installed library already has T265
+  support it reports that and exits without changes.
+
+## Firmware license
+
+The T265 firmware (`target.mvcmd`, v0.2.0.951) is Intel/RealSense, Inc.
+proprietary software. It is **not** part of the Apache-2.0 license, is
+included solely to operate the end-of-life T265 hardware, and must not be
+redistributed beyond this project without permission. See `LEGAL.md` in
+the repository.
diff --git a/packaging/build-deb.sh b/packaging/build-deb.sh
new file mode 100755
index 000000000..6dbf4e7bb
--- /dev/null
+++ b/packaging/build-deb.sh
@@ -0,0 +1,112 @@
+#!/usr/bin/env bash
+#
+# Build a signed Debian package of librealsense2 with T265 (TM2) support.
+#
+# Produces, under the work dir:
+#   librealsense2-t265_<ver>_amd64.deb
+#   librealsense2-t265_<ver>_amd64.deb.asc   (detached PGP signature)
+#   SHA256SUMS
+#
+# The library is installed to /usr/lib (not the multiarch dir) so that the
+# exported CMake package config (whose _IMPORT_PREFIX is computed as four
+# directory levels above <prefix>/lib/cmake/realsense2) resolves correctly.
+# /usr/lib is a built-in default search path for the dynamic loader.
+set -euo pipefail
+
+PKG_NAME="librealsense2-t265"
+PKG_VERSION="2.59.1+tm2.1"
+PKG_ARCH="amd64"
+
+# --- locate directories ---------------------------------------------------
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+BUILD_RELEASE="$REPO_ROOT/build/Release"
+
+# Work + key locations live under the parent of the repo (realsense_test/),
+# NOT in the home folder.
+PARENT_DIR="$(cd "$REPO_ROOT/.." && pwd)"
+WORK_DIR="${T265_WORK_DIR:-$PARENT_DIR/.t265-deb-work}"
+STAGE="$WORK_DIR/pkgroot"
+OUT_DIR="$WORK_DIR/out"
+GNUPG_HOME="${T265_GNUPG_HOME:-$PARENT_DIR/.gnupg}"
+GPG_ID="ntsarb@gmail.com"
+
+say() { printf '%s\n' "$*" >&2; }
+
+# --- sanity checks ---------------------------------------------------------
+[ -f "$BUILD_RELEASE/librealsense2.so.2.59.1" ] || { say "error: $BUILD_RELEASE/librealsense2.so.2.59.1 missing (build the SDK first)"; exit 1; }
+[ -x "$BUILD_RELEASE/rs-enumerate-devices" ]    || { say "error: $BUILD_RELEASE/rs-enumerate-devices missing"; exit 1; }
+[ -f "$GNUPG_HOME/pubring.kbx" ]                || { say "error: GNUPG_HOME $GNUPG_HOME has no keys (generate the GPG key first)"; exit 1; }
+command -v dpkg-deb >/dev/null || { say "error: dpkg-deb not found"; exit 1; }
+
+# Non-graphical tool binaries shipped in the package.
+TOOLS=(rs-enumerate-devices rs-fw-update rs-fw-logger rs-record rs-terminal rs-convert)
+# Static libs referenced by the exported CMake config (required for find_package).
+STATIC_LIBS=(libfw.a librealsense-file.a librs_lz4.a librsutils.a libsqlite3_lib.a)
+
+# --- clean staging ---------------------------------------------------------
+rm -rf "$STAGE" "$OUT_DIR"
+mkdir -p \
+    "$STAGE/DEBIAN" \
+    "$STAGE/usr/lib/cmake/realsense2" \
+    "$STAGE/usr/lib/pkgconfig" \
+    "$STAGE/usr/include" \
+    "$STAGE/usr/bin" \
+    "$STAGE/etc/udev/rules.d" \
+    "$OUT_DIR"
+
+say "[1/5] Staging library + static libs"
+cp "$BUILD_RELEASE/librealsense2.so.2.59.1" "$STAGE/usr/lib/"
+ln -s librealsense2.so.2.59.1 "$STAGE/usr/lib/librealsense2.so.2.59"
+ln -s librealsense2.so.2.59   "$STAGE/usr/lib/librealsense2.so"
+for a in "${STATIC_LIBS[@]}"; do
+    [ -f "$BUILD_RELEASE/$a" ] || { say "error: $a missing in build"; exit 1; }
+    cp "$BUILD_RELEASE/$a" "$STAGE/usr/lib/"
+done
+
+say "[2/5] Staging headers + tools"
+cp -r "$REPO_ROOT/include/librealsense2" "$STAGE/usr/include/librealsense2"
+for t in "${TOOLS[@]}"; do
+    [ -x "$BUILD_RELEASE/$t" ] || { say "error: tool $t missing in build"; exit 1; }
+    cp "$BUILD_RELEASE/$t" "$STAGE/usr/bin/"
+done
+
+say "[3/5] Staging CMake config + pkg-config + udev rule"
+EXP_DIR="$(find "$REPO_ROOT/build/CMakeFiles/Export" -name realsense2Targets.cmake -printf '%h\n' | head -n1)"
+[ -n "$EXP_DIR" ] || { say "error: realsense2Targets.cmake not found under build/"; exit 1; }
+cp "$REPO_ROOT/build/realsense2Config.cmake"          "$STAGE/usr/lib/cmake/realsense2/"
+cp "$REPO_ROOT/build/realsense2ConfigVersion.cmake"  "$STAGE/usr/lib/cmake/realsense2/"
+cp "$EXP_DIR/realsense2Targets.cmake"                "$STAGE/usr/lib/cmake/realsense2/"
+cp "$EXP_DIR/realsense2Targets-release.cmake"        "$STAGE/usr/lib/cmake/realsense2/"
+
+# Fix the pkg-config file: the generated one carries the build-time prefix
+# (/usr/local) and a multiarch libdir that does not match our /usr/lib layout.
+sed -e 's|^prefix=.*|prefix=/usr|' \
+    -e 's|^libdir=.*|libdir=${prefix}/lib|' \
+    "$REPO_ROOT/build/config/realsense2.pc" > "$STAGE/usr/lib/pkgconfig/realsense2.pc"
+
+cp "$REPO_ROOT/config/99-realsense-libusb.rules" "$STAGE/etc/udev/rules.d/"
+
+say "[4/5] Writing control + maintainer scripts"
+cp "$SCRIPT_DIR/control"  "$STAGE/DEBIAN/control"
+cp "$SCRIPT_DIR/postinst" "$STAGE/DEBIAN/postinst"
+chmod 755 "$STAGE/DEBIAN/postinst"
+
+# --- build the .deb --------------------------------------------------------
+DEB="$OUT_DIR/${PKG_NAME}_${PKG_VERSION}_${PKG_ARCH}.deb"
+say "[5/5] Building + signing package"
+dpkg-deb --build --root-owner-group "$STAGE" "$DEB" >/dev/null
+
+export GNUPGHOME="$GNUPG_HOME"
+gpg --batch --yes --detach-sign --armor \
+    --local-user "$GPG_ID" -o "${DEB}.asc" "$DEB"
+
+( cd "$OUT_DIR" && sha256sum "${PKG_NAME}_${PKG_VERSION}_${PKG_ARCH}.deb" > SHA256SUMS )
+
+say ""
+say "=== done ==="
+ls -la "$OUT_DIR"
+say ""
+say "Package:    $DEB"
+say "Signature:  ${DEB}.asc"
+say "SHA256SUMS: $OUT_DIR/SHA256SUMS"
diff --git a/packaging/build-upgrade-tarball.sh b/packaging/build-upgrade-tarball.sh
new file mode 100755
index 000000000..5659002ac
