@@ -0,0 +1,52 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#include <mutex>
+#include <chrono>
+#include <vector>
+#include <iterator>
+#include <cstddef>
+#include <thread>
+
+#include "tm-info.h"
+#include "tm-device.h"
+#include "common/fw/target.h"
+
+#include <src/platform/platform-utils.h>
+#include <src/platform/backend-device-group.h>
+
+namespace librealsense
+{
+    std::shared_ptr<device_interface> tm2_info::create_device()
+    {
+        LOG_DEBUG("tm2_info::create_device " << this);
+        auto const dev_info = std::dynamic_pointer_cast<const tm2_info>(shared_from_this());
+        bool const register_device_notifications = true;
+        return std::make_shared<tm2_device>(dev_info, register_device_notifications);
+    }
+
+    std::vector<std::shared_ptr<tm2_info>> tm2_info::pick_tm2_devices(
+        std::shared_ptr<context> ctx,
+        std::vector<platform::usb_device_info>& usb)
+    {
+        std::vector<std::shared_ptr<tm2_info>> results;
+        // We shouldn't talk to the device here, it might not
+        // even be around anymore (this gets called with an out of
+        // date list on disconnect).
+        auto correct_pid = platform::filter_by_product(usb, { 0x0B37 });
+        if (correct_pid.size())
+        {
+            LOG_INFO("Picked " << correct_pid.size() << "/" << usb.size() << " devices");
+
+            for (auto& dev : correct_pid)
+            {
+                platform::backend_device_group group(std::vector<platform::uvc_device_info>(),
+                    std::vector<platform::usb_device_info>{ dev },
+                    std::vector<platform::hid_device_info>());
+                results.push_back(std::make_shared<tm2_info>(ctx, std::move(group)));
+            }
+        }
+
+        return results;
+    }
+}
