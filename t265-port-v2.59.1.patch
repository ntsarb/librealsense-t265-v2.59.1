+++ b/packaging/build-upgrade-tarball.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+# License: Apache 2.0. See LICENSE file in root directory.
+# Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+#
+# Build the signed upgrade tarball: t265-upgrade.sh + the T265 core lib +
+# its SHA256 sidecar + README-upgrade.md.
+#
+# Produces, under the work dir:
+#   librealsense2-t265-upgrade_<ver>_amd64.tar.gz
+#   librealsense2-t265-upgrade_<ver>_amd64.tar.gz.asc  (detached PGP signature)
+set -euo pipefail
+
+PKG_NAME="librealsense2-t265-upgrade"
+PKG_VERSION="2.59.1+tm2.1"
+PKG_ARCH="amd64"
+
+# --- locate directories ---------------------------------------------------
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+BUILD_RELEASE="$REPO_ROOT/build/Release"
+
+# Work + key locations live under the parent of the repo (realsense_test/),
+# NOT in the home folder.
+PARENT_DIR="$(cd "$REPO_ROOT/.." && pwd)"
+WORK_DIR="${T265_WORK_DIR:-$PARENT_DIR/.t265-deb-work}"
+STAGE="$WORK_DIR/upgrade-root"
+OUT_DIR="$WORK_DIR/out-upgrade"
+GNUPG_HOME="${T265_GNUPG_HOME:-$PARENT_DIR/.gnupg}"
+GPG_ID="ntsarb@gmail.com"
+
+say() { printf '%s\n' "$*" >&2; }
+
+# --- sanity checks ---------------------------------------------------------
+[ -f "$BUILD_RELEASE/librealsense2.so.2.59.1" ] || { say "error: $BUILD_RELEASE/librealsense2.so.2.59.1 missing (build the SDK first)"; exit 1; }
+[ -x "$SCRIPT_DIR/t265-upgrade.sh" ]            || { say "error: t265-upgrade.sh missing next to this script"; exit 1; }
+[ -f "$SCRIPT_DIR/README-upgrade.md" ]         || { say "error: README-upgrade.md missing next to this script"; exit 1; }
+[ -f "$GNUPG_HOME/pubring.kbx" ]                || { say "error: GNUPG_HOME $GNUPG_HOME has no keys (generate the GPG key first)"; exit 1; }
+
+# --- stage ------------------------------------------------------------------
+rm -rf "$STAGE" "$OUT_DIR"
+mkdir -p "$STAGE" "$OUT_DIR"
+
+say "[1/3] Staging script + library + sidecar + README"
+cp "$SCRIPT_DIR/t265-upgrade.sh" "$STAGE/"
+cp "$BUILD_RELEASE/librealsense2.so.2.59.1" "$STAGE/"
+cp "$SCRIPT_DIR/README-upgrade.md" "$STAGE/"
+( cd "$STAGE" && sha256sum librealsense2.so.2.59.1 > librealsense2.so.2.59.1.sha256 )
+
+# --- build + sign ------------------------------------------------------------
+TAR="$OUT_DIR/${PKG_NAME}_${PKG_VERSION}_${PKG_ARCH}.tar.gz"
+say "[2/3] Creating tarball"
+tar -czf "$TAR" -C "$STAGE" \
+    t265-upgrade.sh \
+    librealsense2.so.2.59.1 \
+    librealsense2.so.2.59.1.sha256 \
+    README-upgrade.md
+
+say "[3/3] Signing"
+export GNUPGHOME="$GNUPG_HOME"
+gpg --batch --yes --detach-sign --armor \
+    --local-user "$GPG_ID" -o "${TAR}.asc" "$TAR"
+
+say ""
+say "=== done ==="
+ls -la "$OUT_DIR"
+say ""
+say "Tarball:   $TAR"
+say "Signature: ${TAR}.asc"
