diff --git a/common/fw/CMakeLists.txt b/common/fw/CMakeLists.txt
new file mode 100644
index 000000000..ebc65ecf7
--- /dev/null
+++ b/common/fw/CMakeLists.txt
@@ -0,0 +1,62 @@
+# License: Apache 2.0. See LICENSE file in root directory.
+# Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+#
+# Minimal firmware library for the T265 (TM2 / Myriad 2) only.
+# The FW image is fetched at configure time by scripts/fetch-t265-fw.sh
+# (download + SHA1 verify + local cache) and embedded via .incbin.
+cmake_minimum_required(VERSION 3.10)
+
+project(fw)
+
+set(T26X_FW_VERSION "0.2.0.951" CACHE STRING "T265 firmware version (informational)")
+message(STATUS "Building T265 firmware library (FW ${T26X_FW_VERSION})")
+
+set(_fw_script "${CMAKE_SOURCE_DIR}/scripts/fetch-t265-fw.sh")
+
+execute_process(
+    COMMAND "${_fw_script}"
+    RESULT_VARIABLE _fw_status
+    OUTPUT_VARIABLE _fw_path
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+)
+if(NOT _fw_status EQUAL 0)
+    message(FATAL_ERROR "T265 firmware fetch failed (scripts/fetch-t265-fw.sh, exit ${_fw_status})")
+endif()
+string(STRIP "${_fw_path}" _fw_path)
+if(NOT EXISTS "${_fw_path}")
+    message(FATAL_ERROR "T265 firmware not found at ${_fw_path}")
+endif()
+message(STATUS "Using T265 firmware: ${_fw_path}")
+
+set(SYMBOL target)
+set(symbol target)
+set(version "${T26X_FW_VERSION}")
+string(REPLACE "." "," version_commas "${T26X_FW_VERSION}")
+set(sha1 c3940ccbb0e3045603e4aceaa2d73427f96e24bc)
+string(REPLACE "\\" "\\\\" binary_escaped "${_fw_path}")
+
+add_library(${PROJECT_NAME} STATIC empty.c)
+
+# disable link time optimization for fw by adding -fno-lto to disable -flto flag
+if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+  message(STATUS "disable link time optimization for fw project")
+  target_compile_options(${PROJECT_NAME} PRIVATE -fno-lto)
+endif()
+
+target_include_directories(${PROJECT_NAME}
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_BINARY_DIR}>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>
+)
+
+configure_file(fw.c.in "${CMAKE_CURRENT_BINARY_DIR}/target.c" @ONLY)
+configure_file(fw.h.in "${CMAKE_CURRENT_BINARY_DIR}/target.h" @ONLY)
+set_source_files_properties("${CMAKE_CURRENT_BINARY_DIR}/target.c" OBJECT_DEPENDS "${_fw_path}")
+target_sources(${PROJECT_NAME} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/target.c")
+
+set_target_properties (${PROJECT_NAME} PROPERTIES FOLDER Resources)
+
+install(TARGETS ${PROJECT_NAME} EXPORT realsense2Targets
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
