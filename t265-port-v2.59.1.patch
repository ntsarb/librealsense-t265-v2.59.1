+Package: librealsense2-t265
+Version: 2.59.1+tm2.1
+Architecture: amd64
+Maintainer: Nikolaos Tsarmpopoulos <ntsarb@gmail.com>
+Section: libs
+Priority: optional
+Depends: libc6 (>= 2.34), libgcc-s1, libstdc++6 (>= 12.1), libudev1 (>= 235), libusb-1.0-0
+Provides: librealsense2
+Replaces: librealsense2
+Conflicts: librealsense2
+Description: Intel RealSense SDK with T265 (TM2) tracking support
+ This is the librealsense SDK (v2.59.1) rebuilt with support for the
+ end-of-life Intel RealSense T265 tracking camera, which upstream removed
+ in v2.54.1. It provides the librealsense2 shared library, development
+ headers, the rs-enumerate-devices tool, the CMake package configuration
+ and the udev rules.
+ .
+  The T265 firmware (target.mvcmd, v0.2.0.951) is embedded in the library
+  at build time, so no firmware download is required at runtime. The
+  firmware is Intel/RealSense proprietary (not Apache-2.0); see LEGAL.md.
+ .
+ Note: a manual install of librealsense under /usr/local shadows this
+ package's library in the default loader search path. If you have one,
+ remove /usr/local/lib/librealsense2* and /usr/local/bin/rs-* first so
+ that applications pick up this (T265-enabled) library.
diff --git a/packaging/postinst b/packaging/postinst
new file mode 100755
index 000000000..dcbb2754e
--- /dev/null
+++ b/packaging/postinst
@@ -0,0 +1,17 @@
+#!/bin/sh
+# postinst for librealsense2-t265
+set -e
+
+# Refresh the shared library cache so the newly installed
+# librealsense2.so.2.59 is found by applications.
+ldconfig
+
+# Reload udev rules so the T265 (and other RealSense) USB devices get
+# the correct permissions on (re)plug. Best-effort: no-op if udev is
+# not running (e.g. inside a container).
+if [ -d /run/udev ] && [ -S /run/udev/control ]; then
+    udevadm control --reload-rules >/dev/null 2>&1 || true
+    udevadm trigger >/dev/null 2>&1 || true
+fi
+
+exit 0
diff --git a/packaging/t265-upgrade.sh b/packaging/t265-upgrade.sh
new file mode 100755
index 000000000..e71804067
--- /dev/null
+++ b/packaging/t265-upgrade.sh
@@ -0,0 +1,306 @@
+#!/usr/bin/env bash
+# License: Apache 2.0. See LICENSE file in root directory.
+# Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+#
+# Upgrades an existing librealsense 2.59.x install to the T265-enabled
+# fork. The whole upgrade is replacing the core library
+# librealsense2.so.2.59.1: the fork's library is a strict ABI superset of
+# the standard one (identical public API, same soname) and carries the
+# T265 firmware embedded. Existing tools (rs-*, realsense-viewer),
+# headers, the GL lib and the CMake config stay in place.
+#
+# Usage:
+#   sudo ./t265-upgrade.sh [options] [path-to-t265-lib]
+set -euo pipefail
+
+STATE_DIR="/var/lib/librealsense-t265"
+STATE_FILE="$STATE_DIR/state"
+SONAME_WANTED="librealsense2.so.2.59"
+LIB_NAME="librealsense2.so.2.59.1"
+T265_MARKER="fw_target_data"  # firmware blob symbol, present only in T265 builds
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+say() { printf '%s\n' "$*" >&2; }
+die() { say "error: $*"; exit 1; }
+
+usage() {
+    cat <<EOF
+Usage: sudo $(basename "$0") [options] [path-to-t265-lib]
+
+Upgrade an existing librealsense 2.59.x install to the T265-enabled fork
+by replacing librealsense2.so.2.59.1 (the original is backed up).
+
+Options:
+  --dry-run          Validate everything and print the plan; change nothing
+  --rollback         Restore the original library from the last backup
+  --install-dir DIR  Directory containing the installed library
+                     (auto-detected if omitted)
+  --yes              Do not prompt for confirmation
+  -h, --help         Show this help
+
+[path-to-t265-lib]  The T265 fork's core library (default: $LIB_NAME
+                    next to this script)
+EOF
+}
+
+# --- argument parsing -----------------------------------------------------
+DRY_RUN=0
+ROLLBACK=0
+INSTALL_DIR=""
+YES=0
+NEW_LIB=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --dry-run) DRY_RUN=1 ;;
+        --rollback) ROLLBACK=1 ;;
+        --yes) YES=1 ;;
+        --install-dir) shift; INSTALL_DIR="${1:---install-dir requires a directory}" ;;
+        --install-dir=*) INSTALL_DIR="${1#*=}" ;;
+        -h|--help) usage; exit 0 ;;
+        -*) say "error: unknown option: $1"; usage; exit 2 ;;
+        *) [ -z "$NEW_LIB" ] || die "multiple library paths given"; NEW_LIB="$1" ;;
+    esac
+    shift
+done
+
+# --- helpers ---------------------------------------------------------------
+soname_of() { readelf -d "$1" 2>/dev/null | sed -n 's/.*Library soname: \[\(.*\)\].*/\1/p'; }
+
+has_t265() { nm -D --defined-only "$1" 2>/dev/null | awk -v m="$T265_MARKER" '$3 == m { f = 1 } END { exit f ? 0 : 1 }'; }
+
+sha256_of() { sha256sum "$1" | awk '{ print $1 }'; }
+
+ldcache_entry() {
+    # Path of the first ld.so cache entry for the wanted soname
+    ldconfig -p 2>/dev/null | awk -v s="$SONAME_WANTED" '
+        $1 == s { for (i = 2; i <= NF; i++) if ($i == "=>") { print $(i + 1); f = 1; exit } }
+        END { exit f ? 0 : 1 }'
+}
+
+# The real file behind the core lib in DIR ("" when absent)
+resolve_lib() {
+    local dir="$1" f
+    if [ -e "$dir/$SONAME_WANTED" ]; then
+        f="$(readlink -f "$dir/$SONAME_WANTED")"
+        [ -f "$f" ] || return 1
+        [ "$(dirname "$f")" = "$dir" ] || return 1
+        printf '%s\n' "$f"
+    elif [ -f "$dir/$LIB_NAME" ] && [ ! -L "$dir/$LIB_NAME" ]; then
+        printf '%s\n' "$dir/$LIB_NAME"
+    fi
+}
+
+need_root() {
+    [ "$(id -u)" -eq 0 ] || die "must run as root (writes to the install dir, runs ldconfig); use --dry-run for a non-root check"
+}
+
+validate_new_lib() {
+    [ -f "$NEW_LIB" ] && [ ! -L "$NEW_LIB" ] || die "T265 library not found: $NEW_LIB"
+    [ "$(soname_of "$NEW_LIB")" = "$SONAME_WANTED" ] || die "$NEW_LIB has soname '$(soname_of "$NEW_LIB")', expected $SONAME_WANTED"
+    has_t265 "$NEW_LIB" || die "$NEW_LIB lacks the T265 firmware marker ($T265_MARKER) - not the T265 fork's library"
+    local sidecar="${NEW_LIB}.sha256"
+    if [ -f "$sidecar" ]; then
+        local want got
+        want="$(awk 'NR == 1 { print $1 }' "$sidecar")"
+        got="$(sha256_of "$NEW_LIB")"
+        [ "$want" = "$got" ] || die "SHA256 mismatch for $NEW_LIB: sidecar says $want, actual $got"
+        say "T265 library SHA256 verified against sidecar."
+    else
+        say "warning: no sidecar file $sidecar; skipping SHA256 check"
+    fi
+}
+
+detect_install() {
+    # Sets INSTALL_DIR + TARGET_LIB to the installed standard core library
+    local cache_dir="" d multiarch cache_path
+    cache_path="$(ldcache_entry || true)"
+    [ -n "$cache_path" ] && cache_dir="$(dirname "$cache_path")"
+
+    if [ -z "$INSTALL_DIR" ]; then
+        if [ -n "$cache_dir" ] && [ -n "$(resolve_lib "$cache_dir")" ]; then
+            INSTALL_DIR="$cache_dir"
+        else
+            multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || true)"
+            local dirs=(/usr/local/lib /usr/lib)
+            [ -n "$multiarch" ] && dirs=(/usr/local/lib "/usr/lib/$multiarch" /usr/lib)
+            for d in "${dirs[@]}"; do
+                [ -d "$d" ] || continue
+                if [ -n "$(resolve_lib "$d")" ]; then INSTALL_DIR="$d"; break; fi
+            done
+        fi
+        [ -n "$INSTALL_DIR" ] || die "no librealsense 2.59.x install found (checked the ldconfig cache, /usr/local/lib, /usr/lib, /usr/lib/<multiarch>). For a fresh install use the full .deb from the release page."
+    fi
+
+    TARGET_LIB="$(resolve_lib "$INSTALL_DIR")" || die "no librealsense core library in $INSTALL_DIR"
+    [ "$(basename "$TARGET_LIB")" = "$LIB_NAME" ] || die "the installed core library is named $(basename "$TARGET_LIB"), not $LIB_NAME - upgrade it manually"
+
+    local seen=" $INSTALL_DIR " others=() d2 o
+    for d2 in /usr/local/lib /usr/lib "${multiarch:+/usr/lib/$multiarch}" "${cache_dir:-}"; do
+        [ -n "$d2" ] || continue
+        case "$seen" in *" $d2 "*) continue ;; esac
+        seen="$seen$d2 "
+        if [ -n "$(resolve_lib "$d2")" ]; then others+=("$d2"); fi
+    done
+    if [ ${#others[@]} -gt 0 ]; then
+        say "warning: other librealsense core library copies found in:"
+        for o in "${others[@]}"; do say "  - $o"; done
+        say "upgrading the one the loader resolves first ($INSTALL_DIR)."
+    fi
+}
+
+validate_installed() {
+    [ "$(soname_of "$TARGET_LIB")" = "$SONAME_WANTED" ] || die "installed library has soname '$(soname_of "$TARGET_LIB")', not $SONAME_WANTED - this script upgrades a 2.59.x install"
+    if has_t265 "$TARGET_LIB"; then
+        say "The installed library already has T265 support - nothing to do."
+        exit 0
+    fi
+}
+
+confirm() {
+    [ "$YES" -eq 1 ] && return
+    say "Upgrade plan:"
+    say "  target : $TARGET_LIB"
+    say "  replace: $NEW_LIB"
+    say "  backup : $STATE_DIR/backup/<timestamp>/"
+    local ans
+    read -r -p "Proceed? [y/N] " ans </dev/tty || ans=""
+    case "$ans" in
+        y|Y|yes|YES) ;;
+        *) say "aborted"; exit 0 ;;
+    esac
+}
+
+do_upgrade() {
+    local ts backup_dir tmp state_dir state_tmp
+    ts="$(date +%Y%m%d-%H%M%S)"
+    backup_dir="$STATE_DIR/backup/$ts"
+    mkdir -p "$backup_dir"
+    cp -a "$TARGET_LIB" "$backup_dir/$LIB_NAME"
+    cmp -s "$TARGET_LIB" "$backup_dir/$LIB_NAME" || { rm -rf "$backup_dir"; die "backup verification failed"; }
+    sha256sum "$backup_dir/$LIB_NAME" > "$backup_dir/$LIB_NAME.sha256"
+
+    mkdir -p "$STATE_DIR"
+    state_tmp="$STATE_DIR/.state.tmp.$$"
+    {
+        printf 'target=%s\n' "$TARGET_LIB"
+        printf 'install_dir=%s\n' "$INSTALL_DIR"
+        printf 'backup_dir=%s\n' "$backup_dir"
+        printf 'created=%s\n' "$ts"
+    } > "$state_tmp"
+    mv -f "$state_tmp" "$STATE_FILE"
+
+    tmp="$INSTALL_DIR/.$LIB_NAME.tmp.$$"
+    cp "$NEW_LIB" "$tmp"
+    mv -f "$tmp" "$TARGET_LIB"  # atomic rename in the same dir; symlinks untouched
+    ldconfig
+    say "Replaced $TARGET_LIB and ran ldconfig."
+}
+
+verify_after() {
+    [ "$(soname_of "$TARGET_LIB")" = "$SONAME_WANTED" ] || die "post-swap: soname is '$(soname_of "$TARGET_LIB")', expected $SONAME_WANTED"
+    has_t265 "$TARGET_LIB" || die "post-swap: T265 marker missing in $TARGET_LIB"
+    say "Installed library verified (soname + T265 marker present)."
+
+    local cache_path
+    cache_path="$(ldcache_entry || true)"
+    if [ -n "$cache_path" ] && [ "$(dirname "$cache_path")" = "$INSTALL_DIR" ]; then
+        say "Loader cache: $SONAME_WANTED -> $cache_path"
+    else
+        say "warning: loader cache resolves $SONAME_WANTED to '$cache_path' (expected $INSTALL_DIR)"
+    fi
+
+    local tool=""
+    if command -v rs-enumerate-devices >/dev/null 2>&1; then
+        tool="$(command -v rs-enumerate-devices)"
+    elif [ -x /usr/local/bin/rs-enumerate-devices ]; then
+        tool=/usr/local/bin/rs-enumerate-devices
+    elif [ -x /usr/bin/rs-enumerate-devices ]; then
+        tool=/usr/bin/rs-enumerate-devices
+    fi
+    if [ -n "$tool" ]; then
+        if ldd "$tool" 2>/dev/null | grep -F "$SONAME_WANTED" | grep -qF "$INSTALL_DIR"; then
+            say "Tool check: $tool loads the T265 library from $INSTALL_DIR."
+        else
+            say "warning: $tool does not resolve $SONAME_WANTED to $INSTALL_DIR (check with: ldd $tool)"
+        fi
+        local out
+        if out="$(timeout 30 "$tool" 2>&1)"; then
+            if grep -q "T265" <<< "$out"; then
+                say "Live check: T265 enumerated."
+            else
+                say "Live check: no T265 in $tool output (camera not connected?)"
+            fi
+        else
+            say "Live check: $tool failed to run; skipped."
+        fi
+    else
+        say "No rs-enumerate-devices found; skipped tool and live checks."
+    fi
+}
+
+do_rollback() {
+    [ -f "$STATE_FILE" ] || die "no upgrade state in $STATE_FILE - nothing to roll back"
+    local target install_dir backup_dir
+    target="$(sed -n 's/^target=//p' "$STATE_FILE")"
+    install_dir="$(sed -n 's/^install_dir=//p' "$STATE_FILE")"
+    backup_dir="$(sed -n 's/^backup_dir=//p' "$STATE_FILE")"
+    [ -f "$backup_dir/$LIB_NAME" ] || die "backup missing: $backup_dir/$LIB_NAME"
+    if [ -f "$backup_dir/$LIB_NAME.sha256" ]; then
+        local want got
+        want="$(awk 'NR == 1 { print $1 }' "$backup_dir/$LIB_NAME.sha256")"
+        got="$(sha256_of "$backup_dir/$LIB_NAME")"
+        [ "$want" = "$got" ] || die "backup integrity check failed for $backup_dir/$LIB_NAME"
+    fi
+
+    if [ "$DRY_RUN" -eq 1 ]; then
+        say "Dry run: would restore $backup_dir/$LIB_NAME over $target, run ldconfig, remove $STATE_FILE."
+        return
+    fi
+
+    local tmp="$install_dir/.$LIB_NAME.rtmp.$$"
+    cp -a "$backup_dir/$LIB_NAME" "$tmp"
+    mv -f "$tmp" "$target"
+    ldconfig
+    rm -f "$STATE_FILE"
+
+    [ "$(soname_of "$target")" = "$SONAME_WANTED" ] || die "post-rollback: soname mismatch on $target"
+    if has_t265 "$target"; then
+        say "warning: the restored library still carries the T265 marker"
+    else
+        say "Rollback verified: original library restored ($target)."
+    fi
+    say "To re-apply the upgrade, run this script again without --rollback."
+}
+
+# --- main ------------------------------------------------------------------
+if [ "$ROLLBACK" -eq 1 ]; then
+    [ "$DRY_RUN" -eq 1 ] || need_root
+    do_rollback
+    exit 0
+fi
+
+[ -n "$NEW_LIB" ] || NEW_LIB="$SCRIPT_DIR/$LIB_NAME"
+validate_new_lib
+detect_install
+validate_installed
+
+if [ "$DRY_RUN" -eq 1 ]; then
+    say ""
+    say "Dry run - no changes made."
+    say "  target : $TARGET_LIB"
+    say "  replace: $NEW_LIB"
+    say "  backup : $STATE_DIR/backup/<timestamp>/"
+    say "  to apply: sudo $0 $NEW_LIB"
+    exit 0
+fi
+
+need_root
+confirm
+do_upgrade
+verify_after
+say ""
+say "=== Upgrade complete ==="
+say "Installed: $TARGET_LIB"
+say "Backup:    $(sed -n 's/^backup_dir=//p' "$STATE_FILE")"
+say "Rollback:  sudo $0 --rollback"
diff --git a/readme.md b/readme.md
index a496afc71..0ba15b4a4 100644
--- a/readme.md
+++ b/readme.md
@@ -77,6 +77,82 @@ Here are some examples of the supported models:
 
 > 🛍️ [Explore more stereo products](https://store.realsenseai.com/)
 
+## T265 (TM2) Tracking Camera Support
+
+> **Fork note:** upstream librealsense removed support for the end-of-life
+> T265 in v2.54.1. This fork restores it (SDK module `src/tm2/`) on top of
+> v2.59.1 so the T265 keeps working with a modern SDK.
+
+The Intel RealSense **T265** is a visual-inertial tracking camera (6-DOF pose,
+two fisheye cameras, IMU).
+
+### Streams
+| Stream | Resolution / Type | Rate |
+|--------|-------------------|------|
+| Fisheye ×2 | 848×800 Y8 | 30 Hz |
+| Pose (6-DOF) | — | 200 Hz |
+| Gyro | XYZ32F | 200 Hz |
+| Accel | XYZ32F | 62 Hz |
+
+### Build
+`BUILD_WITH_TM2` is **ON by default** in this fork. A normal build is enough:
+```bash
+cmake -B build -DCMAKE_BUILD_TYPE=Release
+cmake --build build --target realsense2 -j$(nproc)
+cmake --build build --target rs-enumerate-devices -j$(nproc)
+```
+The T265 firmware (`target.mvcmd`, v0.2.0.951) is fetched at configure time by
+`scripts/fetch-t265-fw.sh` (downloaded from the conda-forge librealsense-2.53.1
+package, SHA1-verified, cached under `<repo-parent>/.fw-cache/`; override the
+cache with `T265_FW_CACHE`). It is embedded into the library at build time, so
+applications never download firmware.
+
+### Prebuilt Debian package
+A signed `.deb` (`librealsense2-t265`) is published on the release page. It
+contains the `librealsense2` library, headers, `rs-enumerate-devices`, the CMake
+package config, the pkg-config file and the udev rules — no RealSense Viewer
+(keep the one you already have; it is ABI-compatible).
+
+```bash
+# verify the signature (public key: packaging/keys/realsense-t265.asc)
+gpg --verify librealsense2-t265_2.59.1+tm2.1_amd64.deb.asc librealsense2-t265_2.59.1+tm2.1_amd64.deb
+sudo dpkg -i librealsense2-t265_2.59.1+tm2.1_amd64.deb
+```
+
+### Upgrading an existing 2.59.x install
+
+Already have a standard librealsense 2.59.x install (e.g. a manual build
+under `/usr/local`)? The release page also ships a signed upgrade tarball
+(`librealsense2-t265-upgrade_*.tar.gz`) with `t265-upgrade.sh` and the T265
+core library:
+
+```bash
+tar xzf librealsense2-t265-upgrade_2.59.1+tm2.1_amd64.tar.gz
+gpg --verify librealsense2-t265-upgrade_2.59.1+tm2.1_amd64.tar.gz.asc librealsense2-t265-upgrade_2.59.1+tm2.1_amd64.tar.gz
+sudo ./t265-upgrade.sh              # backs up the original, swaps the core lib, verifies
+sudo ./t265-upgrade.sh --rollback   # restore the original
+```
+
+The fork's core library is a strict ABI superset of the standard one (same
+soname, byte-identical headers, T265 firmware embedded), so only
+`librealsense2.so.2.59.1` is replaced — existing tools, headers and CMake
+config stay in place.
+
+### Notes
+- **USB 3 is required for reliable video.** The T265 enumerates in the Myriad
+  bootloader (USB 2, `03e7:2150`) until the SDK pushes the firmware; it then
+  re-enumerates as the full device (`8087:0b37`). Enumeration and pose work on
+  USB 2, but video streaming should use a USB 3 port.
+- **`/usr/local` shadowing:** if you previously installed librealsense manually
+  under `/usr/local`, its `librealsense2.so.2*` is found before the package's
+  `/usr/lib` copy by the default loader path. Remove
+  `/usr/local/lib/librealsense2*` (and `/usr/local/bin/rs-*`) so applications
+  pick up this T265-enabled library.
+- The T265 firmware is Intel-proprietary and EOL; no further official updates.
+  This is why the repository and package stay private.
+- **Firmware license:** the embedded T265 firmware is Intel/RealSense, Inc.
+  proprietary — it is *not* part of the Apache-2.0 license. See `LEGAL.md`.
+
 ## Getting Started
 
 Start developing with RealSense in minutes using either method below.
diff --git a/scripts/fetch-t265-fw.sh b/scripts/fetch-t265-fw.sh
new file mode 100755
index 000000000..cd1801c15
--- /dev/null
+++ b/scripts/fetch-t265-fw.sh
@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+# Fetch the T265 (Myriad 2 / TM2) firmware image (target.mvcmd).
+#
+# Source: the conda-forge librealsense-2.53.1 linux-64 package, which embeds the
+# FW inside librealsense2.so.2.53.1 (symbols fw_target_data / fw_target_size).
+# The original Intel distribution URL (librealsense.intel.com/Releases/TM2/...)
+# no longer exists.
+#
+# The carved image is verified against the SHA1 that v2.53.1's CMake pins
+# (T26X_FW_SHA1 in the original common/fw/CMakeLists.txt) and cached so
+# rebuilds are offline. The resolved file path is printed on stdout; all
+# progress goes to stderr.
+#
+# Usage: fetch-t265-fw.sh [output-path]
+#   output-path defaults to $T265_FW_CACHE/target.mvcmd
+#                ($T265_FW_CACHE defaults to <repo-parent>/.fw-cache)
+set -euo pipefail
+
+FW_SHA1="c3940ccbb0e3045603e4aceaa2d73427f96e24bc"
+FW_NAME="target.mvcmd"
+# Default cache lives under the repo's parent directory (kept out of $HOME).
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_PARENT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+CACHE_DIR="${T265_FW_CACHE:-$REPO_PARENT/.fw-cache}"
+SOURCE_URL="${T265_FW_SOURCE_URL:-https://conda.anaconda.org/conda-forge/linux-64/librealsense-2.53.1-h8386552_6_cpu.conda}"
+OUT="${1:-$CACHE_DIR/$FW_NAME}"
+say() { echo "$@" >&2; }
+
+mkdir -p "$(dirname "$OUT")"
+
+if [ -f "$OUT" ]; then
+    if echo "$FW_SHA1  $OUT" | sha1sum -c --status 2>/dev/null; then
+        say "T265 firmware cache hit: $OUT"
+        echo "$OUT"
+        exit 0
+    fi
+    say "T265 firmware cache invalid (SHA1 mismatch), re-fetching: $OUT"
+    rm -f "$OUT"
+fi
+
+for tool in python3 zstd unzip nm curl; do
+    command -v "$tool" >/dev/null || { say "error: '$tool' is required"; exit 1; }
+done
+
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+say "Downloading T265 firmware source package:"
+say "  $SOURCE_URL"
+curl -fSL --retry 3 -o "$TMP/pkg.conda" "$SOURCE_URL"
+
+say "Extracting embedded SDK library ..."
+unzip -o -q "$TMP/pkg.conda" -d "$TMP"
+zstd -q -d "$TMP"/pkg-*.tar.zst -o "$TMP/pkg.tar"
+tar -xf "$TMP/pkg.tar" -C "$TMP"
+SO="$TMP/lib/librealsense2.so.2.53.1"
+[ -f "$SO" ] || { say "error: $SO not found in the package"; exit 1; }
+
+say "Carving firmware from $SO ..."
+# default nm format: "value type name"
+nm --defined-only "$SO" | awk '$3=="fw_target_data"{print $1} $3=="fw_target_size"{print $1}' > "$TMP/symaddrs"
+[ "$(wc -l < "$TMP/symaddrs")" -eq 2 ] || { say "error: fw_target_* symbols not found in $SO"; exit 1; }
+
+python3 - "$SO" "$OUT" "$TMP/symaddrs" <<'PYEOF'
+import struct
+import sys
+
+so_path, out_path, addrs_path = sys.argv[1], sys.argv[2], sys.argv[3]
+vaddrs = [int(line.split()[0], 16) for line in open(addrs_path)]
+data_vaddr, size_vaddr = vaddrs
+
+data = open(so_path, 'rb').read()
+assert data[:4] == b'\x7fELF' and data[4] == 2, 'expected 64-bit ELF'
+
+e_phoff = struct.unpack_from('<Q', data, 0x20)[0]
+e_phentsize = struct.unpack_from('<H', data, 0x36)[0]
+e_phnum = struct.unpack_from('<H', data, 0x38)[0]
+
+def file_offset(vaddr):
+    for i in range(e_phnum):
+        off = e_phoff + i * e_phentsize
+        (p_type,) = struct.unpack_from('<I', data, off)
+        if p_type != 1:  # PT_LOAD
+            continue
+        p_offset, p_vaddr, _, p_filesz = struct.unpack_from('<QQQQ', data, off + 8)
+        if p_vaddr <= vaddr < p_vaddr + p_filesz:
+            return p_offset + (vaddr - p_vaddr)
+    raise RuntimeError('vaddr 0x%x not covered by any PT_LOAD segment' % vaddr)
+
+data_off = file_offset(data_vaddr)
+size_off = file_offset(size_vaddr)
+size = struct.unpack_from('<i', data, size_off)[0]
+if not (0 < size < len(data) - data_off):
+    raise RuntimeError('implausible firmware size %d' % size)
+
+open(out_path, 'wb').write(data[data_off:data_off + size])
+print('carved %d bytes' % size, file=sys.stderr)
+PYEOF
+
+say "Verifying SHA1 ..."
+echo "$FW_SHA1  $OUT" | sha1sum -c --strict >&2
+say "T265 firmware ready: $OUT"
+echo "$OUT"
